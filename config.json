{
  // Runtime logging. Keep warnings only to reduce container log volume.
  "log": {
    "level": "warn",
    "timestamp": false
  },

  // Cloud Run receives WebSocket traffic on the configured container port.
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "0.0.0.0",
      "listen_port": 8080,
      "users": [
        {
          // Replace this UUID when provisioning a new client identity.
          "uuid": "123a1567-0f1b-4d3d-baaa-a77e537e4806"
        }
      ],
      "transport": {
        "type": "ws",
        "path": "/gojo/limitless-infinity"
      },
      // Enable sing-box multiplexing and WebSocket padding.
      "multiplex": {
        "enabled": true,
        "padding": true
      }
    }
  ],

  // Resolve DNS locally inside the container.
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local"
      }
    ]
  },

  // Direct is the default route; block is available for explicit deny rules.
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": {
        "server": "local",
        "strategy": "prefer_ipv4"
      }
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],

  // Keep the final outbound explicit. Add routing rules here when needed.
  "route": {
    "rules": [],
    "final": "direct"
  }
}
